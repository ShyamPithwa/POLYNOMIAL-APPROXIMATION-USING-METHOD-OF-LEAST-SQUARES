{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build MM Project",
            "type": "shell",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",

                "${workspaceFolder}/factorizations.cpp",
                "${workspaceFolder}/m1.cpp",
                "${workspaceFolder}/MATRIX.cpp",
                "${workspaceFolder}/NLA_FUNCTIONS.cpp",
                "${workspaceFolder}/eigne_approximators.cpp",

                "-I",
                "C:\\Users\\Shyam\\OneDrive\\eigen-5.0.0\\eigen-5.0.0",

                "-o",
                "${workspaceFolder}/m1.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Run Polynomial approximator using Modified Gram Schmidt",
            "type": "shell",
            "command":  "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",

                "${workspaceFolder}/factorizations.cpp",
                "${workspaceFolder}/MGS_APPROXIMATOR.cpp",
                "${workspaceFolder}/MATRIX.cpp",
                "${workspaceFolder}/NLA_FUNCTIONS.cpp",
               

                "-I",
                "C:\\Users\\Shyam\\OneDrive\\eigen-5.0.0\\eigen-5.0.0",

                "-o",
                "${workspaceFolder}/MGS_APPROXIMATOR.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}